    "steps": { "en": "Steps", "fr": "Calcul" },
    "dayAbout": { "en": "The personal day adds the day of the month to the personal month, reduced to 1–9; the personal month adds the month to the personal year; the personal year adds your birth month and day to the year, from 1 January. Worked out from the birth date alone, on this device.", "fr": "Le jour personnel ajoute le jour du mois au mois personnel, ramené entre 1 et 9 ; le mois personnel ajoute le mois à l’année personnelle ; l’année personnelle ajoute votre mois et votre jour de naissance à l’année, dès le 1er janvier. Calculé à partir de la seule date de naissance, sur cet appareil." },
    "yearHead": { "en": "Your numerology · a band per personal month, a mark on each birthday when a long cycle changes", "fr": "Votre numérologie · une case par mois personnel, une marque à chaque anniversaire où un long cycle change" },
    "universalYear": { "en": "Universal year {n}", "fr": "Année universelle {n}" },
