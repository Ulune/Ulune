# Ulune runs with no environment variable at all. These turn on the synced account
# (docs/sync-protocol.md, section 15). Copy what you need to .env.local (ignored by git) for a
# local run, or set them in the Vercel project. Never put a real value in this file.

# Neon's Postgres connection string (Frankfurt, AWS eu-central-1). Vercel's Neon integration sets
# it when the database is connected with the prefix ACCOUNT_. Without it, production answers every
# account operation 503, and `npm run dev` keeps accounts in .data/account-store.json instead.
ACCOUNT_DATABASE_URL=

# Signs sessions, challenges and device links: at least 32 characters, e.g. `openssl rand -base64 32`.
# Changing it signs every device out for a moment (each comes back with its own device key).
# `npm run dev` makes one in .env.local the first time it is needed.
ACCOUNT_SESSION_SECRET=

# Sent by Vercel's scheduler with the daily clean-up (Authorization: Bearer …). Without it, the
# clean-up refuses to run. Another `openssl rand -base64 32`.
CRON_SECRET=

# Optional: the pages allowed to sign in with passkeys, comma-separated. By default
# https://ulune.app in production, the deployment's own address on a preview, and
# http://localhost:8097 in development (passkeys do not work on http://127.0.0.1).
ACCOUNT_ORIGINS=
